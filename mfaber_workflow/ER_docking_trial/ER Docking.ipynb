# -----------------------------
rows = []
for _, r in df_min.iterrows():
    label = f"{r['protein']} + {r['ligand_native']} | {r['ideal_ligand']}"
    cnn_score = r["CNNpose"]
    cnn_vs = r["CNN_VS"]

    if r["RMSD"] is None:
        rmsd = "NA"
    elif r["RMSD"] == float("inf"):
        rmsd = "inf"
    else:
        rmsd = f"{r['RMSD']:.6f}"

    rows.append(f"{label:<60} {cnn_score:>10.4f} {cnn_vs:>12.6f} {rmsd:>12}")

# -----------------------------
